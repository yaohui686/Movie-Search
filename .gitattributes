# 行尾规范：避免 Windows/macOS 协作者互相"全文件 diff"
* text=auto

# 源码与文本统一 LF
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf

# Windows 批处理必须 CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制
*.png binary
*.exe binary
*.mp4 binary
